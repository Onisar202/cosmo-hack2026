# Скопируйте этот файл в .env и при необходимости отредактируйте значения.
# В репозитории — только имена переменных с комментариями, без значений
# секретов (.ai/main-prompt.md §7).

# Необязательная настройка. Ключ NASA API для архивной линии космической
# погоды — уведомления NASA CCMC DONKI (src/sources/donki.py, используется
# историческими режимами historical_analysis/historical_forecast,
# sources.yaml → nasa-donki-notifications). Если переменная не задана,
# используется публичный демонстрационный ключ NASA DEMO_KEY: он работает,
# не является секретом, но лимитирован ~10 запросами в час на ключ —
# собственный бесплатный ключ (api.nasa.gov) снимает этот лимит.
# Значение НИКОГДА не попадает в сохранённые записи, предупреждения
# результата и логи: record.source_url и все сообщения строятся из URL без
# ключа, а текст ошибок HTTP-клиента маскируется (main-prompt.md §7).
# NASA_API_KEY=

# Обязательная настройка. Окружение запуска: development | staging | production.
APP_ENV=development

# Необязательная настройка. Уровень логирования: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Необязательная настройка. Человекочитаемое имя сервиса (заголовок OpenAPI,
# поле "service" в ответе /health).
SERVICE_NAME=vkd-risk-service

# Необязательная настройка. Путь к файлу SQLite с записями источников и
# результатами расчёта. В проде указывает на подключаемый том, а не на
# временную директорию контейнера — иначе перезапуск теряет сохранённые
# расчёты (.ai/backend-prompt.md §2).
STORE_DB_PATH=data/store.sqlite3

# Необязательная настройка. Каталог с оригиналами ответов источников
# (контент-адресуемое хранилище по SHA-256, см. src/store/records.py).
STORE_RAW_DIR=data/raw

# Необязательная настройка. Шаг расчётной сетки траектории в минутах
# (src/domain/orbit/propagate.py, .ai/main-prompt.md §6 — параметр конфига,
# не константа в коде).
ORBIT_STEP_MINUTES=5.0

# Необязательная настройка. Порог давности орбитальных элементов (в часах),
# свыше которого геометрия для запрошенного момента помечается как
# реконструкция, а не подтверждённая (.ai/main-prompt.md §11 «Траектория»).
ORBIT_MAX_CONFIRMED_AGE_HOURS=24.0
