# Все текстовые файлы репозитория всегда выходят из чекаута с LF, независимо
# от core.autocrlf на клиенте. Без этого правила Windows-чекаут с
# core.autocrlf=true получает CRLF в web/, и `prettier --check` (по умолчанию
# ожидающий eol=lf) падает на каждом файле, хотя содержимое не менялось.
* text=auto eol=lf

# Архивные ответы источников хранятся байт-в-байт: контрольные суммы в
# *.meta.json должны совпадать с тем, что отдал сервер. Без этого правила
# core.autocrlf на Windows меняет концы строк и SHA-256 расходится.
tests/fixtures/sources/archive/** -text
